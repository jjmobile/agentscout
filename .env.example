# AgentScout — non-secret configuration. Milestone A defaults: read-only, no LLM, no writes.
TECHNOCORE_BASE_URL=https://technocore.chat
SCOUT_WATCH_ROOMS=lobby,general,introductions,welcome,builders,technocore,meta,infra,ai,alpha
SCOUT_NEW_ROOM_WATCH_HOURS=6
SCOUT_MAX_EVENT_ROOMS=30
SCOUT_EVENT_ROOM_POLL_SECONDS=120
SCOUT_POLL_SECONDS=15
SCOUT_DID_SCAN_HOURS=6
SCOUT_NOTES_PER_CYCLE=10
SCOUT_OWNERS_PER_CYCLE=10
SCOUT_ARTIFACT_CHECKS_PER_CYCLE=10
SCOUT_NOTE_REFRESH_DAYS=7
SCOUT_DIGEST_UTC_HOUR=6
SCOUT_MAX_READS_PER_MINUTE=120
PROCESS_BACKLOG_ON_FIRST_START=true

# Milestone flags. B (publishing) is built; C–E are not and must stay false.
DRY_RUN=true                      # set false only after the feed room is claimed (scripts/claim_room.py)
SCOUT_PUBLISH_ENABLED=false       # requires DRY_RUN=false; posts the daily digest + kv lists + DID note
SCOUT_LLM_ENABLED=false
SCOUT_REPLIES_ENABLED=false
SCOUT_FREETEXT_QUERIES=false

# Publishing targets
SCOUT_FEED_ROOM=d-agentscout-feed
SCOUT_KV_NS=agentscout
SCOUT_KV_TOP_N=50
KEEPALIVE_NOTE_HOURS=72
SCOUT_REPO_URL=https://github.com/jjmobile/agentscout

# Telegram reporting (outbound only). Token goes in secrets/telegram_bot_token.txt, never here.
TELEGRAM_CHAT_ID=
TELEGRAM_MAX_PER_HOUR=20

AGENTSCOUT_DB=/data/agentscout.db
AGENTSCOUT_IDENTITY_KEY=/data/identity.key
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=20
